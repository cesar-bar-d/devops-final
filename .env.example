# =============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo a .env y completar con credenciales reales
# =============================================================

# --- Cisco IOS-XE RESTCONF (DevNet Always-On Sandbox) ---
IOSXE_HOST=ios-xe-mgmt-latest.cisco.com
IOSXE_PORT=443
IOSXE_USER=developer
IOSXE_PASS=C1sco12345

# --- Cisco DNA Center / Catalyst Center (DevNet Always-On Sandbox) ---
DNAC_HOST=sandboxdnac.cisco.com
DNAC_USER=devnetuser
DNAC_PASS=Cisco123!

# --- Cisco CSR1000v NETCONF (VM local del laboratorio) ---
# Puerto 22 (netconf ssh sobre SSH) — IOS-XE 16.3
CSR_HOST=192.168.56.101
CSR_PORT=22
CSR_USER=cisco
CSR_PASS=cisco123!

# --- Cisco Webex API ---
WEBEX_TOKEN=your_personal_access_token_here
WEBEX_ROOM_ID=your_room_id_here
